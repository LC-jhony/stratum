  "tokenColors": [
    {
      "name": "Comment / doc comment text",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#5D6976",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tag (bold)",
      "scope": [
        "comment.block.documentation keyword",
        "storage.type.class.jsdoc",
        "keyword.other.documentation"
      ],
      "settings": {
        "foreground": "#5D6976",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Keyword, Operator, Identifier, Special, Title",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as",
        "keyword.operator",
        "keyword.operator.arrow",
        "punctuation.accessor",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language.this",
        "variable.language.self",
        "variable.language.parent",
        "variable.language.static",
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#B87EA2"
      }
    },
    {
      "name": "Variable, constant identifier, doc comment param",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.property",
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.language",
        "meta.parameter.type.variable"
      ],
      "settings": {
        "foreground": "#9876AA"
      }
    },
    {
      "name": "Function / method declaration",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "meta.function.php entity.name.function",
        "storage.type.function"
      ],
      "settings": {
        "foreground": "#DB6E89"
      }
    },
    {
      "name": "Function call, instance method",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call support.function",
        "support.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#F9B5AC"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.none"
      ],
      "settings": {
        "foreground": "#F2C4B3"
      }
    },
    {
      "name": "Class name, static field, doc comment type",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.name.namespace",
        "entity.name.module",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "variable.other.property.static"
      ],
      "settings": {
        "foreground": "#73A7A7"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string punctuation.section.embedded source"
      ],
      "settings": {
        "foreground": "#8FBC94"
      }
    },
    {
      "name": "Type (also used for html string / heredoc)",
      "scope": [
        "support.type.primitive",
        "storage.type.built-in",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#73A7A7"
      }
    },
    {
      "name": "String literal / backtick / template",
      "scope": [
        "string.template",
        "punctuation.definition.template-expression",
        "markup.raw",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#A5C25C"
      }
    },
    {
      "name": "HTML / XML Tag name",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#FFAE8F"
      }
    },
    {
      "name": "HTML / XML Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#D0D6B5"
      }
    },
    {
      "name": "CSS Property / attribute (2)",
      "scope": [
        "meta.property-name",
        "support.type.property-name",
        "meta.property-value",
        "support.constant.property-value"
      ],
      "settings": {
        "foreground": "#CDD3D3"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid.broken",
        "invalid.deprecated",
        "invalid.illegal",
        "invalid.unimplemented"
      ],
      "settings": {
        "foreground": "#E5484D",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Message Error",
      "scope": [
        "message.error"
      ],
      "settings": {
        "foreground": "#E5484D"
      }
    },
    {
      "name": "Regexp",
      "scope": [
        "source.regexp",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#F2C4B3"
      }
    },
    {
      "name": "Regexp escape (bold)",
      "scope": [
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#A5C25C"
      }
    },
    {
      "name": "Markup List",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#B87EA2"
      }
    },
    {
      "name": "Markup Quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#57A464"
      }
    },
    {
      "name": "Markup Italic",
      "scope": [
        "markup.italic"
      ],
