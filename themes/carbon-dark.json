    {
      "name": "PHP: Magic Constants / doc identifier",
      "scope": [
        "constant.language.php",
        "support.constant.core.php",
        "storage.type.php.doctag"
      ],
      "settings": {
        "foreground": "#9876AA"
      }
    },
    {
      "name": "JSON boolean",
      "scope": [
        "constant.language.json"
