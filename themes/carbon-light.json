  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#718096",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tag",
      "scope": [
        "comment.block.documentation keyword",
        "storage.type.class.jsdoc",
        "keyword.other.documentation"
      ],
      "settings": {
        "foreground": "#718096",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, Operator, Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as",
        "keyword.operator",
        "keyword.operator.arrow",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#9B59B6"
      }
    },
    {
      "name": "Variable language (this, self)",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.parent",
        "variable.language.static"
      ],
      "settings": {
        "foreground": "#8E44AD"
      }
    },
    {
      "name": "Variable, constant, parameter",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.property",
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "meta.parameter.type.variable"
      ],
      "settings": {
        "foreground": "#2C3E50"
      }
    },
    {
      "name": "Function / method declaration",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "meta.function.php entity.name.function",
        "storage.type.function"
      ],
      "settings": {
        "foreground": "#D2451F"
      }
    },
    {
      "name": "Function call, support function",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call support.function",
        "support.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#D35400"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.none"
      ],
      "settings": {
        "foreground": "#B7950B"
      }
    },
    {
      "name": "Class name, type, namespace",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.name.namespace",
        "entity.name.module",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "variable.other.property.static"
      ],
      "settings": {
        "foreground": "#16A085"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string punctuation.section.embedded source"
      ],
      "settings": {
        "foreground": "#1E8449"
      }
    },
    {
      "name": "Type primitive",
      "scope": [
        "support.type.primitive",
        "storage.type.built-in",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#16A085"
      }
    },
    {
      "name": "Template string",
      "scope": [
        "string.template",
        "punctuation.definition.template-expression",
        "markup.raw",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#27AE60"
      }
    },
    {
      "name": "HTML / XML Tag name",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#FF4262"
      }
    },
    {
      "name": "HTML / XML Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8E44AD"
      }
    },
    {
      "name": "CSS Property",
      "scope": [
        "meta.property-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#2980B9"
      }
    },
    {
      "name": "CSS Value",
      "scope": [
        "meta.property-value",
        "support.constant.property-value"
      ],
      "settings": {
        "foreground": "#16A085"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid.broken",
        "invalid.deprecated",
        "invalid.illegal",
        "invalid.unimplemented"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#C53030"
      }
    },
    {
      "name": "Message Error",
      "scope": [
        "message.error"
      ],
      "settings": {
        "foreground": "#C53030"
      }
    },
    {
      "name": "Regexp",
      "scope": [
        "source.regexp",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#B7950B"
      }
    },
    {
      "name": "Regexp escape",
      "scope": [
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#1E8449"
      }
    },
    {
      "name": "Markup Heading",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#C0392B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup List",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#9B59B6"
      }
    },
    {
      "name": "Markup Quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#718096",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4A5568"
      }
    },
    {
      "name": "Markup Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#2D3748"
      }
    },
    {
      "name": "Markup Deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#C53030"
      }
    },
    {
      "name": "Markup Inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#276749"
      }
    },
    {
      "name": "Markup Changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#B7950B"
      }
    },
    {
      "name": "Link",
      "scope": [
        "constant.other.reference.link",
        "string.other.link",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#2980B9",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#718096"
      }
    },
    {
      "name": "Decorator / Annotation",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#A66A00"
      }
    },
    {
      "name": "Preprocessor / Directive",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#7D5BA6"
      }
    },
    {
      "name": "PHP: Special Variables",
      "scope": [
        "variable.language.this.php",
        "variable.other.php",
        "punctuation.definition.variable.php"
      ],
      "settings": {
        "foreground": "#8E44AD"
      }
    },
    {
      "name": "PHP: Magic Constants",
      "scope": [
        "constant.language.php",
        "support.constant.core.php",
        "storage.type.php.doctag"
      ],
      "settings": {
        "foreground": "#2980B9"
      }
    },
    {
      "name": "JSON key",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#2C3E50"
      }
    },
    {
      "name": "JSON value string",
      "scope": [
        "string.quoted.double.json"
