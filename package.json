{
  "name": "stratum",
  "productName": "Stratum",
  "version": "0.1.0",
  "description": "A DataGrip-style database IDE with VS Code theme compatibility",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": {
    "name": "LC-jhony",
    "email": "jhonyapm94@gmail.com"
  },
  "homepage": "https://github.com/LC-jhony/stratum",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "fetch:jdbc": "node scripts/fetch-jdbc-adapter.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "smoke": "electron-vite build && STRATUM_SMOKE=$PWD/scripts/smoke.js xvfb-run -a electron . --no-sandbox --disable-gpu"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@vscode/codicons": "^0.0.46-24",
    "basic-ftp": "^6.2.3",
    "cassandra-driver": "^4.10.0",
    "dockerode": "^5.0.1",
    "elkjs": "^0.9.3",
    "ioredis": "^6.0.0",
    "jsonc-parser": "^3.3.1",
    "kafkajs": "^2.2.4",
    "monaco-editor": "^0.52.2",
    "mongodb": "^7.7.0",
    "mysql2": "^3.11.4",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.2",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^4.3.3",
    "dependency-cruiser": "^18.6.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "mongodb-memory-server": "^11.3.0",
    "redis-memory-server": "^0.17.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
